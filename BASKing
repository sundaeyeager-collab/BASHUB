MainTab:CreateSection("Teleport Features")

MainTab:CreateButton({
   Name = "5. วาร์ปไปจุดขายปืน (Teleport to Gun Shop)",
   Callback = function()
      if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
         local gunShopPos = nil

         -- ค้นหาจุดขายปืนอัตโนมัติจากชื่อโมเดล/NPC ในแมพ
         for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Part") then
               local lowerName = string.lower(obj.Name)
               if string.find(lowerName, "gun") or string.find(lowerName, "weapon") or string.find(lowerName, "armory") or string.find(lowerName, "shop") then
                  if obj:IsA("BasePart") then
                     gunShopPos = obj.CFrame
                     break
                  elseif obj:IsA("Model") and obj.PrimaryPart then
                     gunShopPos = obj.PrimaryPart.CFrame
                     break
                  elseif obj:IsA("Model") then
                     local part = obj:FindFirstChildWhichIsA("BasePart")
                     if part then
                        gunShopPos = part.CFrame
                        break
                     end
                  end
               end
            end
         end

         -- ย้ายตัวละคร
         if gunShopPos then
            LocalPlayer.Character.HumanoidRootPart.CFrame = gunShopPos + Vector3.new(0, 3, 0)
            Rayfield:Notify({
               Title = "BAS HUB Notification",
               Content = "วาร์ปไปยังจุดขายปืนเรียบร้อยแล้ว!",
               Duration = 3,
               Image = 4483362458,
            })
         else
            Rayfield:Notify({
               Title = "BAS HUB Notification",
               Content = "ไม่พบจุดขายปืนในแมพนี้ (โปรดตรวจสอบชื่อจุดในแมพ)",
               Duration = 4,
               Image = 4483362458,
            })
         end
      end
   end,
})

-- Loop Update RenderStepped
RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- อัปเดตตำแหน่งวงกลม FOV กลางจอ
    FOVCircle.Position = screenCenter
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = FOVVisible

    -- ทำงาน Aimbot
    if AimbotEnabled then
        local targetHead = GetClosestVisibleHead()
        if targetHead then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Smoothness)
        end
    end
end)
