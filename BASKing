local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "BAS HUB",
   LoadingTitle = "BAS HUB Loading...",
   LoadingSubtitle = "by BAS",
   ConfigurationSaving = {
      Enabled = false
   },
   KeySystem = false
